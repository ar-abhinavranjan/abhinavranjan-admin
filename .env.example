# Set these in Netlify > Site configuration > Environment variables (mark secrets as secret).
# NEVER commit real values.

# Private repo that holds submissions (same one the main site writes to)
GITHUB_TOKEN=            # fine-grained token, ONLY data-netlify, Contents: Read and write
GITHUB_REPO_OWNER=ar-abhinavranjan
GITHUB_SUBMISSIONS_REPO=data-netlify
SUBMISSIONS_PATH=contact_submissions.json
STATE_PATH=admin_state.json
GITHUB_BRANCH=main

# Admin login (generate with: node tools/make-hash.js)
ADMIN_USER=
ADMIN_PASS_HASH=         # output of tools/make-hash.js, starts with scrypt:
ADMIN_SESSION_SECRET=    # 48+ random bytes, see README
